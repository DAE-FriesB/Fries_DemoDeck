<Window x:Class="Ex.App.Dialogs.ChangesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Changes" Width="1040" Height="680" MinWidth="640" MinHeight="400" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg0}" Foreground="{DynamicResource Text}" FontFamily="{StaticResource UiFont}" FontSize="13"
        ShowInTaskbar="False">
    <Window.Resources>
        <!-- Diff line: +/- tinted like a code review -->
        <DataTemplate x:Key="DiffLineTemplate">
            <Border Background="{Binding Background}" Padding="12,0">
                <TextBlock Text="{Binding Text}" Foreground="{Binding Foreground}" />
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" MinWidth="220" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,14">
            <TextBlock Text="Unsaved changes" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" />
            <TextBlock x:Name="SubtitleText" Style="{StaticResource Muted}" Margin="0,2,0,0" />
        </StackPanel>

        <!-- File list -->
        <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="8,12,8,8">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="8,0,4,8">
                    <Button DockPanel.Dock="Right" Content="Select all" Style="{StaticResource GhostButton}" MinHeight="24"
                            FontSize="12" Click="OnSelectAll" />
                    <TextBlock x:Name="CountText" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                </DockPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="4,8,4,0">
                    <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="4,0,0,8"
                               Text="Ctrl-click or Shift-click to select several files." />
                    <Button x:Name="DiscardButton" Style="{StaticResource DangerButton}" HorizontalAlignment="Stretch" Click="OnDiscard" />
                </StackPanel>

                <TextBlock x:Name="NoChangesText" DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="8,4" Visibility="Collapsed"
                           Text="No unsaved changes." />

                <ListBox x:Name="FileList" SelectionMode="Extended" SelectionChanged="OnSelectionChanged" KeyDown="OnListKeyDown"
                         VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="8,5" />
                            <Setter Property="Margin" Value="0,0,0,1" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="DiscardMenuItem" Click="OnDiscard" />
                            <Separator />
                            <MenuItem Header="Show in Explorer" Click="OnShowInExplorer" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel ToolTip="{Binding FullPath}">
                                <!-- Status badge, like GitHub Desktop -->
                                <Border DockPanel.Dock="Right" Width="18" Height="18" CornerRadius="4" Margin="8,0,0,0"
                                        Background="{Binding BadgeSoft}" ToolTip="{Binding KindText}">
                                    <TextBlock Text="{Binding Badge}" Foreground="{Binding BadgeBrush}" FontSize="11" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                    <Run Text="{Binding Folder, Mode=OneWay}" Foreground="{DynamicResource TextMuted}" /><Run Text="{Binding FileName, Mode=OneWay}" />
                                </TextBlock>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Row="1" Grid.Column="1" Width="12" HorizontalAlignment="Stretch" Background="Transparent" />

        <!-- Diff -->
        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Panel}" Padding="0">
            <DockPanel>
                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="16,10">
                    <TextBlock x:Name="DiffTitle" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                </Border>
                <Grid>
                    <TextBlock x:Name="DiffMessage" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <ListBox x:Name="DiffList" FontFamily="{StaticResource MonoFont}" FontSize="12" Padding="0,6"
                             ItemTemplate="{StaticResource DiffLineTemplate}" Focusable="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
