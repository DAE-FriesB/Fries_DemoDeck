<Window x:Class="Ex.App.Dialogs.CleanStateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unsaved changes" Width="600" SizeToContent="Height" MaxHeight="780"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource Bg1}" Foreground="{DynamicResource Text}" FontFamily="{StaticResource UiFont}" FontSize="13"
        ShowInTaskbar="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20">
            <TextBlock x:Name="HeadingText" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="DetailsText" Style="{StaticResource Muted}" Margin="0,4,0,18" />

            <!-- Only when entering Demo mode (not in the UI yet) -->
            <Border x:Name="DemoPanel" Background="{DynamicResource CoralSoft}" CornerRadius="10" Padding="14,12" Margin="0,0,0,18"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" FontWeight="Medium" Foreground="{DynamicResource Coral}"
                               Text="In Demo mode every switch throws away unsaved changes automatically, without asking. Unity's Library folder is kept." />
                    <CheckBox x:Name="UnderstandDemo" Margin="0,10,0,0" Checked="OnCheckChanged" Unchecked="OnCheckChanged"
                              Content="I understand" />
                </StackPanel>
            </Border>

            <StackPanel x:Name="DirtyPanel" Visibility="Collapsed">
                <TextBlock Text="CHANGED FILES" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                <TextBox x:Name="FilesText" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="12" Height="150"
                         Background="{DynamicResource Bg0}" Padding="10,8"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />

                <!-- Option 1: save -->
                <Border Background="{DynamicResource Bg2}" CornerRadius="10" Padding="14,12" Margin="0,18,0,8">
                    <StackPanel>
                        <TextBlock Text="Save them" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,10" Text="Store the changes where they are (a commit)." />
                        <DockPanel>
                            <Button x:Name="CommitButton" DockPanel.Dock="Right" Content="Save" Style="{StaticResource PrimaryButton}"
                                    Click="OnCommit" Margin="8,0,0,0" />
                            <TextBox x:Name="CommitMessage" TextChanged="OnCommitMessageChanged" ToolTip="What did you do?" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Option 2: put aside -->
                <Border Background="{DynamicResource Bg2}" CornerRadius="10" Padding="14,12" Margin="0,0,0,8">
                    <DockPanel>
                        <Button x:Name="StashButton" DockPanel.Dock="Right" Content="Put aside" Click="OnStash" Margin="12,0,0,0"
                                VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="Put them aside" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"
                                       Text="Keep them outside the project so they can be brought back later (git stash)." />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Option 3: throw away -->
                <Border Background="{DynamicResource Bg2}" CornerRadius="10" Padding="14,12">
                    <DockPanel>
                        <Button x:Name="DiscardButton" DockPanel.Dock="Right" Content="Throw away" Style="{StaticResource DangerButton}"
                                Click="OnDiscard" Margin="12,0,0,0" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="Throw them away" FontWeight="SemiBold" />
                            <CheckBox x:Name="UnderstandDiscard" Margin="0,8,0,0" Checked="OnCheckChanged" Unchecked="OnCheckChanged"
                                      Content="I understand these changes will be permanently lost" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="Cancel" IsCancel="True" />
                <Button x:Name="ProceedButton" Style="{StaticResource PrimaryButton}" Click="OnProceed" Visibility="Collapsed" Margin="8,0,0,0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
