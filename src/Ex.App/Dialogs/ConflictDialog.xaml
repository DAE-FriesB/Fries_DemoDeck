<Window x:Class="Ex.App.Dialogs.ConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Both changed the same files" Width="620" SizeToContent="Height" MaxHeight="760" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Bg1}" Foreground="{DynamicResource Text}" FontFamily="{StaticResource UiFont}" FontSize="13"
        ShowInTaskbar="False">
    <StackPanel Margin="24,20">
        <TextBlock x:Name="HeadingText" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="IntroText" Style="{StaticResource Muted}" Margin="0,4,0,18" />

        <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="FileList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource Bg2}" CornerRadius="10" Padding="14,12" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{Binding File}" FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="0,0,0,10"
                                           TextTrimming="CharacterEllipsis" />
                                <RadioButton GroupName="{Binding File}" IsChecked="{Binding KeepLater}" Margin="0,0,0,6">
                                    <TextBlock>
                                        <Run Text="{Binding KeepLaterText, Mode=OneWay}" />
                                        <Run Text="{Binding KeepLaterNote, Mode=OneWay}" Foreground="{DynamicResource TextMuted}" />
                                    </TextBlock>
                                </RadioButton>
                                <RadioButton GroupName="{Binding File}" IsChecked="{Binding TakeEarlier}" Content="{Binding TakeEarlierText}"
                                             Margin="0,0,0,6" />
                                <RadioButton GroupName="{Binding File}" IsChecked="{Binding ByHand}"
                                             Content="I merged it by hand in my editor (no conflict markers left)" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"
                   Text="Your choice is carried forward: the steps after this one normally merge without asking again." />

        <DockPanel Margin="0,22,0,0">
            <Button DockPanel.Dock="Left" Content="Stop propagating" Style="{StaticResource GhostButton}" Click="OnAbort"
                    ToolTip="Cancel this merge. Steps that were already updated stay updated." />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Continue" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="OnContinue" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
