<Window x:Class="Ex.App.Dialogs.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource Bg1}" Foreground="{DynamicResource Text}" FontFamily="{StaticResource UiFont}" FontSize="13"
        ShowInTaskbar="False">
    <StackPanel Margin="24,20">
        <TextBlock x:Name="HeadingText" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock x:Name="MessageText" Style="{StaticResource Muted}" Margin="0,0,0,18" />

        <StackPanel x:Name="TextPanel">
            <TextBlock x:Name="TextLabel" Style="{StaticResource Caption}" Margin="0,0,0,6" />
            <TextBox x:Name="InputText" Margin="0,0,0,18" />
        </StackPanel>

        <StackPanel x:Name="Choice1Panel">
            <TextBlock x:Name="Choice1Label" Style="{StaticResource Caption}" Margin="0,0,0,6" />
            <ComboBox x:Name="Choice1" Margin="0,0,0,18" />
        </StackPanel>

        <StackPanel x:Name="Choice2Panel">
            <TextBlock x:Name="Choice2Label" Style="{StaticResource Caption}" Margin="0,0,0,6" />
            <ComboBox x:Name="Choice2" Margin="0,0,0,18" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
            <Button x:Name="OkButton" Content="OK" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="OnOk" />
        </StackPanel>
    </StackPanel>
</Window>
