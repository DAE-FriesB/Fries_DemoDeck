<Window x:Class="Ex.App.Dialogs.PropagateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Propagate" Width="560" SizeToContent="Height" MaxHeight="720" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource Bg1}" Foreground="{DynamicResource Text}" FontFamily="{StaticResource UiFont}" FontSize="13"
        ShowInTaskbar="False">
    <StackPanel Margin="24,20">
        <TextBlock x:Name="HeadingText" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="IntroText" Style="{StaticResource Muted}" Margin="0,4,0,18" />

        <TextBlock Text="MERGED INTO, IN THIS ORDER" Style="{StaticResource Caption}" Margin="0,0,0,8" />
        <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="StepList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource Bg2}" CornerRadius="10" Padding="14,10" Margin="0,0,0,6">
                            <DockPanel>
                                <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Fill="{Binding Dot}" Margin="0,0,12,0"
                                         VerticalAlignment="Center" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                                    <TextBlock Text="{Binding Note}" Foreground="{Binding NoteBrush}" FontSize="12" Margin="0,2,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock x:Name="ConflictHint" Style="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0" Visibility="Collapsed"
                   Text="Where both sides changed the same file, the app stops and asks which version to keep. You decide once; the choice is carried to the steps after it." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
            <Button x:Name="OkButton" Content="Propagate" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="OnOk" />
        </StackPanel>
    </StackPanel>
</Window>
