<Window x:Class="Ex.App.Dialogs.StashesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Put-aside changes" Width="960" Height="600" MinWidth="620" MinHeight="380" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg0}" Foreground="{DynamicResource Text}" FontFamily="{StaticResource UiFont}" FontSize="13"
        ShowInTaskbar="False">
    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" MinWidth="240" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,14">
            <TextBlock Text="Put-aside changes" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap"
                       Text="Changes kept outside the projects with Put aside (git stash). Restore brings them back into the project; Drop deletes them." />
        </StackPanel>

        <!-- Stash list -->
        <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="8,12,8,8">
            <DockPanel>
                <TextBlock x:Name="CountText" DockPanel.Dock="Top" Style="{StaticResource Caption}" Margin="8,0,4,8" />
                <TextBlock x:Name="NoStashesText" DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="8,4" Visibility="Collapsed"
                           TextWrapping="Wrap" Text="Nothing put aside." />
                <ListBox x:Name="StashList" SelectionChanged="OnSelectionChanged" KeyDown="OnListKeyDown">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="10,7" />
                            <Setter Property="Margin" Value="0,0,0,2" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel ToolTip="{Binding Tooltip}">
                                <TextBlock Text="{Binding Heading}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Message}" Foreground="{DynamicResource TextSecondary}" FontSize="12"
                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Age}" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Row="1" Grid.Column="1" Width="12" HorizontalAlignment="Stretch" Background="Transparent" />

        <!-- Files of the selected stash -->
        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Panel}" Padding="0">
            <DockPanel>
                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="16,10">
                    <TextBlock x:Name="FilesTitle" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                </Border>
                <Grid>
                    <TextBlock x:Name="FilesMessage" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <ListBox x:Name="FileList" Padding="6" Focusable="False">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="8,4" />
                                <Setter Property="Margin" Value="0,0,0,1" />
                                <Setter Property="Focusable" Value="False" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Width="18" Height="18" CornerRadius="4" Margin="8,0,0,0"
                                            Background="{Binding BadgeSoft}" ToolTip="{Binding KindText}">
                                        <TextBlock Text="{Binding Badge}" Foreground="{Binding BadgeBrush}" FontSize="11" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Path}">
                                        <Run Text="{Binding Folder, Mode=OneWay}" Foreground="{DynamicResource TextMuted}" /><Run Text="{Binding FileName, Mode=OneWay}" />
                                    </TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Actions -->
        <DockPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" Margin="8,0,0,0" />
            <Button x:Name="RestoreButton" DockPanel.Dock="Right" Content="Restore" Style="{StaticResource PrimaryButton}"
                    Click="OnRestore" Margin="8,0,0,0" MinWidth="96" />
            <Button x:Name="DropButton" DockPanel.Dock="Right" Content="Drop..." Style="{StaticResource DangerButton}" Click="OnDrop" />
            <TextBlock x:Name="HintText" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                       Margin="0,0,16,0" />
        </DockPanel>
    </Grid>
</Window>
