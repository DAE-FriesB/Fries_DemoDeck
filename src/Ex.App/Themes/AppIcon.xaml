<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        App icon: two cards stacked diagonally (a demo deck), the front one carrying an "F".
        Drawn on a 256 x 256 canvas. tools/IconGen renders this same drawing into Assets/app.ico,
        so edit it here and re-run the generator.
    -->
    <DrawingImage x:Key="AppIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Fixed canvas so every size scales the same way -->
                <GeometryDrawing Brush="Transparent">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,256,256" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- Back card (teal), up and to the right -->
                <GeometryDrawing Brush="#4CA5B0">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="80,12,164,164" RadiusX="36" RadiusY="36" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- Front card (coral), down and to the left. The navy outline separates the two cards. -->
                <GeometryDrawing Brush="#F65D53">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#161930" Thickness="14" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="12,80,164,164" RadiusX="36" RadiusY="36" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- The F (navy), heavy enough to read at 16 px -->
                <GeometryDrawing Brush="#212544">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup FillRule="Nonzero">
                            <RectangleGeometry Rect="58,118,30,92" RadiusX="5" RadiusY="5" />
                            <RectangleGeometry Rect="58,118,82,28" RadiusX="5" RadiusY="5" />
                            <RectangleGeometry Rect="58,160,66,26" RadiusX="5" RadiusY="5" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
